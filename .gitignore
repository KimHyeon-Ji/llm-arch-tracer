# 가상환경 (requirements.txt로 재생성)
.venv/
venv/
env/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# 로컬 작업 공간 (README: develop/out은 검증 전/반복 중 산출물, 통과분만 models/로 승격)
develop/out/

# 축 분리 probe 의 트레이스(다른 seq_len). develop/out 과 같은 성격의
# 중간 산출물이고 promote 대상이 아니다 -- 프로파일만 커밋한다.
develop/probe_out/

# HF 캐시가 프로젝트 안에 생기는 경우 대비 (기본은 ~/.cache/huggingface, 보통 프로젝트 밖)
.cache/
.hf_cache/

# OS / 에디터
.DS_Store
Thumbs.db
.vscode/
.idea/

# 리뷰 패킷은 산출물에서 생성되는 파생물 (develop/make_review_packet.py로 언제든 재생성)
develop/review/

# upstream transformers 소스 캐시 (src/source_check.py 가 매 실행 자동 재다운로드)
develop/sources/

# 개인 메모 (푸시 안 함)
MEMO.md

# Kimi-K3 (2.8T, 93레이어 -- 지금까지 온보딩한 모델 중 가장 큼)의 raw trace/prefill.csv가
# GitHub 파일당 100MB 한도를 넘는다(각각 ~300MB, ~121MB). 로컬에는 그대로 두고 재생성마다
# 계속 쓰지만, git에는 안 올린다 -- 재클론 후 필요하면 src/run.py --profile
# develop/models/phase25-kimi-k3.yaml 로 재트레이스(약 40분). 다른 산출물(structure.yaml,
# model_summary.md, decode.csv, full/prefill.shapes.concrete.jsonl 등)은 전부 한도 안이라 그대로 커밋된다.
models/moonshotai__Kimi-K3/full/prefill.trace.raw.jsonl
models/moonshotai__Kimi-K3/full/prefill.csv
# 축 원장과 포트 기록도 그 뒤 한도를 넘었다(2026-09-21 측정: 660MB / 130MB). 한동안
# 커밋되다가 push 때 처음 막혔다 -- GitHub 은 받는 쪽에서 blob 크기를 보므로, 로컬
# 커밋이 쌓이는 동안에는 아무 신호가 없었다. 이미 들어간 7 개 커밋은 git-filter-repo
# 로 이 경로만 들어냈다(커밋 메시지·순서는 그대로). 재트레이스로 복구된다.
models/moonshotai__Kimi-K3/full/prefill.axis_resolution.jsonl
models/moonshotai__Kimi-K3/full/prefill.ports.jsonl
